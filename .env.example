# ─────────────────────────────────────────────────────────────────────
# ECRN environment variables
# Copy to .env.local for local development.
# ─────────────────────────────────────────────────────────────────────

# Supabase (public — also committed in .env.production and wrangler.jsonc)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Show the demo-account buttons and the floating "View as" switcher.
NEXT_PUBLIC_DEMO_MODE=true

# Secret — password for the two demo accounts. In production set it with:
#   npx wrangler secret put DEMO_ACCOUNT_PASSWORD
DEMO_ACCOUNT_PASSWORD=

# Optional: force the base URL used in invite links.
NEXT_PUBLIC_APP_URL=

# Notifications (future) — leave blank to log to console.
RESEND_API_KEY=
SENDGRID_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ─────────────────────────────────────────────────────────────────────
# Staffing Referrals / Bullhorn / Sense
# Full guide: docs/BULLHORN_INTEGRATION.md. Everything below is a SECRET.
# Leave blank locally; in production set each one with
#   npx wrangler secret put NAME
# The app works with all of them blank: events queue and nothing is lost.
# ─────────────────────────────────────────────────────────────────────

# Outbound: where ECRN sends events (given to us by Staffing Referrals).
STAFFING_REFERRALS_WEBHOOK_URL=

# Shared secret, used both ways: ECRN signs what it sends and checks what it
# receives (HMAC-SHA256 of the request body, header X-ECRN-Signature).
# Make a long random value, e.g. `openssl rand -hex 32`, and give the same
# value to Staffing Referrals.
STAFFING_REFERRALS_SECRET=

# Supabase secret key (Project Settings → API keys → secret / service_role).
# Server only. Lets the inbound webhook and the scheduler write without a
# signed-in admin. Bypasses Row Level Security, so never expose it.
SUPABASE_SECRET_KEY=

# Protects POST /api/integrations/dispatch (scheduled delivery). The scheduler
# sends it as `authorization: Bearer <CRON_SECRET>`. e.g. `openssl rand -hex 32`
CRON_SECRET=

# Bullhorn direct API (optional second route; not needed for Staffing Referrals).
# Client id + secret come from Bullhorn Support. Then EITHER the dedicated API
# user's username + password (preferred) OR a refresh token.
BULLHORN_CLIENT_ID=
BULLHORN_CLIENT_SECRET=
BULLHORN_USERNAME=
BULLHORN_PASSWORD=
BULLHORN_REFRESH_TOKEN=
# Only if a redirect URI was registered with the Bullhorn API key.
BULLHORN_REDIRECT_URI=
# Only to skip Bullhorn's data-centre lookup (normally leave blank).
BULLHORN_OAUTH_URL=
BULLHORN_REST_URL=
