# ─────────────────────────────────────────────────────────────────────
# ECRN environment variables
# Copy to .env.local for local development.
# ─────────────────────────────────────────────────────────────────────

# Supabase (public — also committed in .env.production and wrangler.jsonc)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Show the demo-account buttons and the floating "View as" switcher.
NEXT_PUBLIC_DEMO_MODE=true

# Secret — password for the two demo accounts. In production set it with:
#   npx wrangler secret put DEMO_ACCOUNT_PASSWORD
DEMO_ACCOUNT_PASSWORD=

# Optional: force the base URL used in invite links.
NEXT_PUBLIC_APP_URL=

# Notifications (future) — leave blank to log to console.
RESEND_API_KEY=
SENDGRID_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Bullhorn (future)
BULLHORN_CLIENT_ID=
BULLHORN_CLIENT_SECRET=
BULLHORN_REFRESH_TOKEN=
