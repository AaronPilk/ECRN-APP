{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ecrn",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  // Public values only. Secrets (DEMO_ACCOUNT_PASSWORD) are set with
  // `npx wrangler secret put DEMO_ACCOUNT_PASSWORD` and never committed.
  "vars": {
    "NEXT_PUBLIC_SUPABASE_URL": "https://izsbniekpywmpjwmheyg.supabase.co",
    "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY": "sb_publishable_IJ-yLhLRsxqMMy9aoeJOSg_Scn-LVmQ",
    "NEXT_PUBLIC_DEMO_MODE": "true"
  }
}
